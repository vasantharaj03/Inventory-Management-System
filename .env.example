# ==============================================================================
# Stockroom Environment Configuration Template
# Copy this file to .env and configure your credentials
# ==============================================================================

# Database Connection URL (Recommended)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Note: If your password contains special characters, URL encode them (e.g. '@' -> '%40', '#' -> '%23')
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/inventory_db

# Discrete Database Settings (used as fallback if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=YOUR_PASSWORD
# DB_NAME=inventory_db

# Security & Session Token Secret
# Change this to a secure random string for production
JWT_SECRET=change-this-to-a-secure-random-secret
